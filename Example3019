#Class Variable vs Object Variable
class Student:
    school_name = "ABC School"   # class variable

    def __init__(self, name):
        self.name = name          # object variable

s1 = Student("Ravi")
s2 = Student("Meena")

print(s1.name)
print(s2.name)
print(s1.school_name)
print(s2.school_name)

#school_name is shared by all students.
